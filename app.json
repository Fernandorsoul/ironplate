{
  "expo": {
    "name": "ironplate",
    "slug": "fernando",
    "version": "1.0.0",
    "versionCode": 1,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ironplate",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rsoul.ironplate"
    },
    "android": {
      "package": "com.rsoul.ironplate",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita acesso as fotos para definir sua foto de perfil.",
          "cameraPermission": "Permita acesso a camera para tirar sua foto de perfil.",
          "microphonePermission": false
        }
      ],
      "react-native-ble-plx"
    ],
    "extra": {
      "eas": {
        "projectId": "61e15f61-c0fc-47bd-8b0e-003e3a8de2f7"
      }
    },
    "owner": "fernandorsouls-team"
  }
}
