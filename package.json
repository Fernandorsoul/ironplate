{
  "name": "ironplate",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@neondatabase/serverless": "^1.2.0",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/react-native-skia": "2.14.0",
    "drizzle-orm": "^0.45.4",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-modules-core": "~58.0.30",
    "expo-print": "~58.0.8",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "postgres": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-ble-plx": "^3.5.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.1",
    "victory-native": "^43.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.4.1",
    "@types/react": "~19.3.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vercel/node": "^12.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "playwright": "^1.62.1",
    "react-test-renderer": "19.2.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "vercel-build": "expo export",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:smoke": "npx playwright test e2e/smoke.spec.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:diagnose": "tsx scripts/diagnose-migrate.ts",
    "password-reset:check": "tsx scripts/check-password-reset-readiness.ts",
    "sync:release-news": "node scripts/sync-release-news.mjs",
    "eas-build-post-install": "node scripts/sync-release-news.mjs",
    "lint": "eslint api src App.tsx index.ts scripts/*.ts --report-unused-disable-directives",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "testMatch": [
      "**/__tests__/**/*.[jt]s?(x)",
      "**/?(*.)+(spec|test).[jt]s?(x)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.qwen/",
      "/e2e/"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 60,
        "branches": 60
      }
    }
  },
  "private": true
}
