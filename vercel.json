{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/((?!api/).*)", "dest": "/index.html" }
  ],
  "git": {
    "deploymentEnabled": {
      "master": true,
      "dev": false,
      "staging": false,
      "feat/*": false,
      "feature/*": false
    }
  }
}
