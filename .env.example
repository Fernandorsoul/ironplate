# Neon Database Connection String
# Get this from your Neon dashboard: https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/database
# Direct (non-pooler) connection used only by npm run db:migrate
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database

# Comma-separated list of allowed origins for CORS.
# Defaults to https://ironplate-phi.vercel.app when unset.
# Outside production, http://localhost:* and http://127.0.0.1:* are also allowed
# (covers the Expo dev server on :8081 and Expo web on :19006).
ALLOWED_ORIGINS=https://ironplate-phi.vercel.app

# Random secret with at least 32 characters used to sign access tokens.
JWT_SECRET=replace-with-at-least-32-random-characters

# Public API origin used by native Expo builds. Leave blank for same-origin web deployments.
EXPO_PUBLIC_API_BASE_URL=https://ironplate-phi.vercel.app
# Public app origin used to recognize password-reset links in native builds.
EXPO_PUBLIC_APP_URL=https://ironplate-phi.vercel.app

# Password reset delivery through Resend.
APP_URL=https://ironplate-phi.vercel.app
RESEND_API_KEY=re_your_api_key
RESET_EMAIL_FROM=IronPlate <noreply@example.com>
